#!/usr/bin/env bash
#MISE description="Build and verify the reproducible generated C bundle"
set -euo pipefail

project_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
work_dir=$(mktemp -d "${TMPDIR:-/tmp}/grpc-lite-check-transpiled-c.XXXXXX")
output_dir=${GRPC_LITE_TRANSPILED_C_DIST_DIR:-"$project_root/.zig-cache/transpiled-c-dist"}
cleanup() {
    local status=$?
    rm -rf "$work_dir"
    return "$status"
}
trap cleanup EXIT

if [[ -n "$(git -C "$project_root" ls-files transpiled)" ]]; then
    printf '%s\n' 'Generated C must not be tracked under transpiled/' >&2
    exit 1
fi
if git -C "$project_root" archive HEAD | tar -tf - | grep -q '^transpiled/'; then
    printf '%s\n' 'git archive unexpectedly contains transpiled/' >&2
    exit 1
fi

rm -rf "$output_dir"
mkdir -p "$output_dir"
GRPC_LITE_ZIG_CACHE_DIR="$work_dir/cache-1" \
    "$project_root/tools/package_transpiled_c.sh" "$output_dir"
archive_1=("$output_dir/"*.tar.gz)
if [[ ${#archive_1[@]} -ne 1 ]]; then
    printf '%s\n' 'Packaging did not produce exactly one archive on the first run' >&2
    exit 1
fi
cp "${archive_1[0]}" "$work_dir/first.tar.gz"
cp "${archive_1[0]}.sha256" "$work_dir/first.tar.gz.sha256"

GRPC_LITE_ZIG_CACHE_DIR="$work_dir/cache-2" \
    "$project_root/tools/package_transpiled_c.sh" "$output_dir"
archive_2=("$output_dir/"*.tar.gz)
if [[ ${#archive_2[@]} -ne 1 ]]; then
    printf '%s\n' 'Packaging did not produce exactly one archive on the second run' >&2
    exit 1
fi
cmp "$work_dir/first.tar.gz" "${archive_2[0]}"
cmp "$work_dir/first.tar.gz.sha256" "${archive_2[0]}.sha256"
(
    cd "$output_dir"
    sha256sum --check "$(basename "${archive_2[0]}").sha256"
)

printf 'Reproducible transpiled C bundle: %s\n' "${archive_2[0]}"
