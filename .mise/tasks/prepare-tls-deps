#!/usr/bin/env bash
#MISE description="Prepare the pinned optional wolfSSL package"
set -euo pipefail

if [[ -n "${GRPC_LITE_DEPENDENCY_CACHE:-}" ]]; then
  test -f "$GRPC_LITE_DEPENDENCY_CACHE/p/N-V-__8AAM2AGgrmA8dlFOS4GWaTOEXwdZvSYXeSgZpe09he.tar.gz"
  exit 0
fi

url='https://codeload.github.com/wolfSSL/wolfssl/tar.gz/3c5eead44904df64e6a5a1f4ebdce377d35a849a'
hash='N-V-__8AAM2AGgrmA8dlFOS4GWaTOEXwdZvSYXeSgZpe09he'
cache_dir="${ZIG_GLOBAL_CACHE_DIR:-$HOME/.cache/zig}/p"
mkdir -p "$cache_dir"

if [[ ! -d "$cache_dir/$hash" ]]; then
  output=$(zigfetch "$url" 2>&1)
  actual_hash=${output##*$'\n'}
  if [[ "$actual_hash" != "$hash" ]]; then
    printf 'wolfSSL hash mismatch: expected %s, got %s\n' "$hash" "$actual_hash" >&2
    exit 1
  fi
fi

if [[ ! -f "$cache_dir/$hash.tar.gz" ]]; then
  curl -fsSL -o "$cache_dir/$hash.tar.gz" "$url"
fi
